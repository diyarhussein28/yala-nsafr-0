# App
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
# Browser origins allowed to call the API in production (comma-separated). The mobile
# app and the bundled admin panel need no entry.
CORS_ORIGINS=
# Set to the number of proxies in front of the API (e.g. 1 behind nginx) so rate
# limiting sees real client IPs
TRUST_PROXY=

# Database (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yala_nsafr
DB_USER=yala_user
DB_PASS=yala_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
# At least 32 random characters — production refuses to boot otherwise.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret
# Short-lived; the app and admin panel renew it with the 30-day refresh token
JWT_EXPIRES_IN=15m

# OTP SMS provider — options: stub | twilio | vonage
# Phone numbers must be in E.164 format (+20XXXXXXXXXX for Egypt)
SMS_PROVIDER=stub

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Vonage / Nexmo (https://dashboard.nexmo.com) — alternative to Twilio
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=YalaNsafr

# Firebase Cloud Messaging (push notifications)
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# Payments — Kashier
# Get these from https://portal.kashier.io/en/dashboard/integration
KASHIER_MERCHANT_ID=MID-XXXXX-X
# Payment API Key — verifies payment (transaction) webhook signatures
KASHIER_API_KEY=
# Secret key — sent as the Authorization header on every Kashier API call
KASHIER_SECRET_KEY=
# Transfer API Key — a SEPARATE credential used only to verify payout webhook
# signatures. Payout webhooks are rejected (and reconciliation takes over) until set.
KASHIER_TRANSFER_API_KEY=

# true = skip Kashier HTTP calls and return mock responses, for local work without
# credentials. false exercises the real sandbox.
PAYMENT_MOCK=false

# Commission
DEFAULT_COMMISSION_RATE=0.10

# File storage. local = this server's disk (single instance only); s3 = any
# S3-compatible bucket (AWS S3, Cloudflare R2, MinIO). Identity documents and dispute
# evidence are always private and handed out as 15-minute signed links.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket (or CDN) for profile/car photos
S3_PUBLIC_BASE_URL=

# Error tracking (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Google Maps
GOOGLE_MAPS_API_KEY=
